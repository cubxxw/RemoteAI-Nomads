{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roamorrow-nomads-mcp",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/api/*", "/healthz"]
  },
  "ratelimits": [
    {"name": "BURST_LIMIT", "namespace_id": "606261001", "simple": {"limit": 20, "period": 10}},
    {"name": "MINUTE_LIMIT", "namespace_id": "606261002", "simple": {"limit": 120, "period": 60}}
  ],
  "vars": {"MCP_ENABLED": "true"}
}
