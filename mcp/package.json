{
  "name": "@roamorrow/nomads-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "test": "node --test tests/*.test.js",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8795",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run data && npm run package:skill && npm test && npm run build",
    "test:live": "node scripts/smoke.mjs",
    "package:skill": "python3 scripts/package-skill.py"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "wrangler": "4.153.0"
  }
}
